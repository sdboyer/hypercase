{
  "format": 9,
  "updateVar": "SHEETS_UPDATE_GOLDEN",
  "corpusRoot": "step11",
  "rootPackage": false,
  "codes": true,
  "positions": true,
  "issueLinks": [
    {
      "pattern": "sheets#(\\d+)",
      "url": "https://example.com/sheets/issues/$1"
    }
  ],
  "properties": [
    {
      "name": "circular",
      "description": "Some cell's formula refers back to itself, directly or through other cells."
    },
    {
      "name": "dangling",
      "description": "Some formula refers to a cell the sheet doesn't have."
    }
  ],
  "types": [
    {
      "dir": "csv",
      "description": "A CSV export: one file, in/csv/<name>.csv, with a name holding a character that is neither white space nor a format character; one row of the sheet per record, where a quoted field may hold a newline.",
      "goType": "github.com/sdboyer/hypercase/walkthrough/sheets/step11/sheetcorpus.CSV",
      "transforms": []
    },
    {
      "dir": "sheet",
      "description": "A spreadsheet: one file per cell under in/sheet/, holding a number or a formula.",
      "goType": "github.com/sdboyer/hypercase/walkthrough/sheets/step11/sheetcorpus.Sheet",
      "transforms": [
        {
          "name": "looped",
          "description": "The first cell in cell order, row by row then column by column, replaced by a reference to itself, so the sheet has a cycle.",
          "gives": [
            "circular"
          ],
          "keeps": [],
          "probe": true,
          "owned": false
        },
        {
          "name": "renamed",
          "description": "Every cell moved one row down, A1 to A2, with every reference rewritten to the moved cell.",
          "gives": [],
          "keeps": [
            "circular",
            "dangling"
          ],
          "probe": true,
          "owned": false
        }
      ]
    }
  ],
  "lifts": [
    {
      "name": "import",
      "description": "Turns each CSV field into a cell: row 1, field 2 is B1.",
      "input": "github.com/sdboyer/hypercase/walkthrough/sheets/step11/sheetcorpus.CSV",
      "product": "github.com/sdboyer/hypercase/walkthrough/sheets/step11/sheetcorpus.Sheet",
      "owned": false,
      "bytes": true,
      "corpora": [
        "csv"
      ],
      "paths": [
        {
          "corpus": "csv",
          "lifts": []
        }
      ],
      "outputs": [
        {
          "pattern": "error.txt",
          "description": "The line the importer can't read, and why.",
          "inputs": "positions"
        }
      ],
      "productFiles": [
        {
          "pattern": "sheet/*",
          "description": "One file per cell, as a sheet's in/sheet/ holds them.",
          "inputs": "func"
        }
      ],
      "rejects": [
        "out-of-range",
        "stray-quote",
        "unterminated"
      ]
    },
    {
      "name": "parse",
      "description": "Parses every cell.",
      "input": "github.com/sdboyer/hypercase/walkthrough/sheets/step11/sheetcorpus.Sheet",
      "product": "*github.com/sdboyer/hypercase/walkthrough/sheets/sheet.Parsed",
      "owned": false,
      "bytes": false,
      "corpora": [
        "csv",
        "sheet"
      ],
      "paths": [
        {
          "corpus": "csv",
          "lifts": [
            "import"
          ]
        },
        {
          "corpus": "sheet",
          "lifts": []
        }
      ],
      "outputs": [
        {
          "pattern": "error.txt",
          "description": "The cell that is neither a number nor a formula.",
          "inputs": "positions"
        }
      ],
      "productFiles": [],
      "rejects": [
        "malformed"
      ]
    }
  ],
  "suites": [
    {
      "name": "format",
      "description": "Prints each formula back in canonical form.",
      "consumes": "*github.com/sdboyer/hypercase/walkthrough/sheets/sheet.Parsed",
      "corpora": [
        "csv",
        "sheet"
      ],
      "paths": [
        {
          "corpus": "csv",
          "lifts": [
            "parse",
            "import"
          ]
        },
        {
          "corpus": "sheet",
          "lifts": [
            "parse"
          ]
        }
      ],
      "outputs": [
        {
          "pattern": "formulas.txt",
          "description": "Each formula cell and its formula, in cell order.",
          "inputs": "func"
        }
      ],
      "rejects": [],
      "classifier": null
    }
  ],
  "checks": []
}
